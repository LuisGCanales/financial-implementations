include pyproject.toml MANIFEST.in README.md CHANGELOG.md LICENSE
recursive-include src/yield_curves *.py
prune tests
prune scripts
prune data
prune config
prune docs
prune evidence
prune outputs
prune notebooks
prune .notes
prune .venv
prune .git
prune .task-checkpoints
prune build
prune dist
prune requirements
global-exclude *.py[cod] __pycache__ .DS_Store *.log *.tmp *.bak *~ .env .env.*
